{
  "name": "@gerb-24/centered-grid",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "prepare": "husky install",
    "build:dev": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs -w",
    "build": "rollup -c rollup.config.mjs",
    "prebuild": "rimraf ./lib",
    "lint-staged": "lint-staged",
    "lint": "npm run eslint && npm run prettier",
    "format": "npm run eslint:fix && npm run prettier:fix",
    "eslint": "eslint \"**/*.ts?(x)\"",
    "eslint:fix": "eslint --fix \"**/*.ts?(x)\"",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "serve": "vite"
  },
  "unpkg": "lib/bundle.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "keywords": [
    "motion-canvas"
  ],
  "author": "",
  "homepage": "",
  "peerDependencies": {
    "@motion-canvas/2d": "^3.14.2",
    "@motion-canvas/core": "^3.14.1"
  },
  "devDependencies": {
    "@motion-canvas/ui": "^3.17.2",
    "@motion-canvas/vite-plugin": "^3.17.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.17.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-node-externals": "^8.1.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,md,scss,json,mjs}": "prettier --write"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
